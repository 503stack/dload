{
  "name": "dload",
  "version": "1.0.2",
  "description": "Downloader for server",
  "author": "fuzzknob",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "aria:dev": "turbo run dev --filter=@dload/aria",
    "client:dev": "turbo run dev --filter=@dload/client",
    "server:dev": "turbo run dev --filter=@dload/server"
  },
  "dependencies": {
    "turbo": "^2.0.0"
  }
}
