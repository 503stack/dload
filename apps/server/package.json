    "socket.io": "^4.5.2"
  },
  "devDependencies": {
    "@dload/shared": "*",
    "@dload/tsconfig": "*",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/lodash": "^4.14.184",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "tslib": "^2.4.0",
